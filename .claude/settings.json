{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(biome check:*)",
      "WebSearch",
      "WebFetch(domain:bun.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.strapi.io)",
      "WebFetch(domain:forum.strapi.io)",
      "WebFetch(domain:strapi.io)",
      "WebFetch(domain:www.npmjs.com)",
      "mcp__filesystem__list_directory",
      "mcp__filesystem__directory_tree",
      "mcp__filesystem__read_text_file",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(git ls-tree:*)",
      "Bash(gh pr view:*)",
      "Bash(gh workflow:*)",
      "Bash(az containerapp logs show:*)",
      "Bash(az containerapp show:*)",
      "Bash(podman compose:*)",
      "Bash(podman build:*)",
      "Bash(bun install:*)",
      "Bash(bun run build:*)",
      "Bash(bun run dev:*)",
      "Bash(bun run format:*)",
      "Bash(bun run lint:*)",
      "Bash(npx eslint:*)",
      "Bash(bun pm ls:*)",
      "Bash(bun run typecheck:*)",
      "Bash(npx playwright test --list)",
      "Bash(bun test:*)",
      "Bash(npx playwright test:*)",
      "Bash(bun run test:report:*)",
      "Bash(gh secret list:*)",
      "Bash(bun --version:*)",
      "Bash(curl:*)",
      "Bash(gh pr list:*)",
      "Bash(git checkout:*)",
      "Bash(bun:*)",
      "Bash(ls:*)",
      "Bash(git add:*)",
      "Bash(git merge-base:*)",
      "Bash(git worktree:*)",
      "Bash(lsof:*)",
      "Bash(ss:*)",
      "Bash(timeout 5 curl:*)",
      "Bash(test:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(podman volume inspect:*)",
      "Bash(podman ps:*)",
      "Bash(podman exec:*)",
      "Bash(podman inspect:*)",
      "Bash(podman logs:*)",
      "Bash(npx tsc:*)",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_stripe_stripe__get_stripe_account_info",
      "Bash(PLAYWRIGHT_BROWSERS_PATH=/usr/bin npx playwright install:*)",
      "Bash(gh api:*)",
      "Bash(bunx vitest:*)",
      "mcp__playwright__browser_navigate",
      "Bash(wc:*)",
      "Bash(node -e:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(podman-compose ps:*)",
      "Bash(bunx tsc:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__plugin_sentry_sentry__get_issue_details",
      "mcp__plugin_sentry_sentry__find_organizations",
      "mcp__plugin_sentry_sentry__get_issue_tag_values",
      "mcp__plugin_sentry_sentry__search_issue_events",
      "Bash(npx vitest:*)",
      "Bash(bunx biome check:*)",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_snapshot"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["playwright"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/biome-hook.mjs"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/play-sound.sh question"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/play-sound.sh done"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
