# Clever Cloud env files (filled-in copies of iac/clever-cloud/*.example).
# The .example templates are committed; the populated .env files contain
# secrets and must never be committed.
iac/clever-cloud/*.env

# Clever Cloud local link metadata (created by `clever create` / `clever link`).
# Holds app IDs per shell — those are managed via repo secrets in CI.
**/.clever.json

#Ignore vscode AI rules
.github\instructions\codacy.instructions.md

BACKLOG.md
.playwright-mcp

# Database dump files from migration
*.dump

packages/videos/out

############################
# graphify knowledge graph
############################

# Built graph artifacts. Everyone rebuilds locally via `bun run graphify:setup`
# (first build) or `graphify update .` (incremental, AST-only, no API cost).
# To switch to a shared team graph instead: stop ignoring graphify-out/graph.json
# and graphify-out/GRAPH_REPORT.md, then run `graphify hook install` so the
# union merge driver keeps graph.json conflict-free.
graphify-out/

# Rolling backup graphify writes before it edits a Claude settings file.
*.graphify-bak
