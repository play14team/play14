#
# Host port mapping for the local container stack (read by podman-compose).
#
# Copy to `.env` (gitignored) and override only what collides with another
# project already running on this machine. Every value below is the default —
# an absent or empty `.env` reproduces the historical port layout exactly.
#
#   cp .env.example .env
#
# Only the HOST side of each mapping changes. Container-internal ports are
# fixed, so nothing inside the compose network needs to know about these.
#
# A value already exported in your shell wins over this file, so a one-off
# remap needs no edit at all:
#
#   PLAY14_DB_PORT=15432 PLAY14_REDIS_PORT=16379 bun run deps
#

# PostgreSQL 17 — mirror in packages/api/.env: DATABASE_PORT
PLAY14_DB_PORT=5432

# Ephemeral PostgreSQL for integration tests
# — mirror in packages/api/.env: TEST_DATABASE_PORT
PLAY14_DB_TEST_PORT=5433

# Redis 7 (cache + distributed cron locks)
# — mirror in packages/api/.env: REDIS_URL
PLAY14_REDIS_PORT=6379

# Strapi API — mirror in packages/web/.env.local: STRAPI_API_URL and
# NEXT_PUBLIC_STRAPI_URL
PLAY14_API_PORT=1337

# Strapi Prometheus metrics — mirror in packages/api/.env: METRICS_PORT
PLAY14_API_METRICS_PORT=9000

# Next.js frontend
PLAY14_WEB_PORT=3000

# MinIO S3 API and web console (stands in for the Cellar add-on)
PLAY14_MINIO_PORT=9100
PLAY14_MINIO_CONSOLE_PORT=9101

# pgAdmin
PLAY14_PGADMIN_PORT=5050

# Storybook (packages/design)
PLAY14_DESIGN_PORT=8080

#
# The API and web app read their OWN env files when you run them on the host
# (`bun run api`, `bun run web`, `bun run test:int`) rather than in a container,
# so those files have to mirror any change above by hand:
#
#   packages/api/.env       DATABASE_PORT, REDIS_URL, TEST_DATABASE_PORT
#   packages/web/.env.local STRAPI_API_URL, NEXT_PUBLIC_STRAPI_URL
#
# `bun run deps` prints the host port of every service it starts and warns when
# packages/api/.env has drifted out of sync.
#
