# Strapi API — STAGING environment on Clever Cloud
#
# Copy this file to env-staging-api.env and fill in the secrets, then:
#   ./set-env.sh play14-api-staging env-staging-api.env
#
# DO NOT commit env-staging-api.env — it's gitignored.
#
# Notes:
# - POSTGRESQL_ADDON_*, CELLAR_ADDON_*, REDIS_* are auto-injected by linked
#   add-ons; do not set them here.
# - database.ts falls back to POSTGRESQL_ADDON_* automatically; no need to
#   duplicate DB credentials as env vars.

# --- Clever Cloud runtime ---------------------------------------------------
CC_NODE_VERSION=22
CC_NODE_BUILD_TOOL=bun
# This is a Bun workspace monorepo deployed from the repo root.
# Clever Cloud's Bun runtime swallows --cwd flags when parsing
# CC_RUN_COMMAND, so use a root-level alias script instead. start:api
# in the root package.json delegates to packages/api.
CC_RUN_COMMAND=bun run start:api
# NOTE: Strapi admin-panel build needs >1GB RAM. The build instance flavor
# is NOT an env var — set it via `clever scale --build-flavor M --alias <app>`.
# Build the API package after install. The default buildpack only runs
# `bun install`; Strapi needs an explicit admin-panel build.
CC_POST_BUILD_HOOK=bun run build:api

# --- Strapi core ------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PUBLIC_URL=https://api-staging.play14.org

# Generate fresh values: openssl rand -base64 32 (run 5 times)
APP_KEYS=REPLACE_KEY1,REPLACE_KEY2,REPLACE_KEY3,REPLACE_KEY4
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME

# --- Database --------------------------------------------------------------
# DO NOT set DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD here — Clever Cloud
# does not perform shell-style $VAR expansion on env values, so a literal
# "$POSTGRESQL_ADDON_HOST" string would be passed straight to Knex.
# packages/api/config/database.ts falls back to the POSTGRESQL_ADDON_*
# vars that the linked add-on auto-injects, so leave these unset.
DATABASE_CLIENT=postgres
DATABASE_SCHEMA=public
DATABASE_SSL=true
DATABASE_SSL_SELF=false
DATABASE_DEBUG=false

# --- Object storage (Cellar via @strapi/provider-upload-aws-s3) -----------
UPLOAD_PROVIDER=s3
# Bucket name must match the CDN hostname (CNAME bucket pattern).
# Cloudflare proxies with Host: cdn-staging.play14.org → Cellar matches
# the bucket by name, no Host header rewrite needed.
CELLAR_BUCKET=cdn-staging.play14.org
CELLAR_REGION=us-east-1
STORAGE_CDN_URL=https://cdn-staging.play14.org

# --- Redis (cron lock + strapi-cache) --------------------------------------
# The Clever Cloud Redis add-on injects REDIS_URL directly (along with
# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD). DO NOT set REDIS_URL here —
# Clever Cloud does not perform $VAR expansion on env values.
CACHE_PROVIDER=redis
CACHE_ENABLED=true
CACHE_DEBUG=false
# The web app sends a Bearer token on every request. Without this, all
# authenticated requests bypass the cache entirely.
CACHE_AUTHORIZED_REQUESTS=true

# --- Email (Sender.net) -----------------------------------------------------
SENDER_API_KEY=REPLACE_ME
SENDER_GROUP_ID=REPLACE_ME
EMAIL_DEFAULT_FROM=noreply@play14.org
EMAIL_DEFAULT_FROM_NAME=#play14 community
EMAIL_REPLY_TO=admin@play14.org
EMAIL_ADMIN_RECIPIENTS=admin@play14.org

# --- Invitations ------------------------------------------------------------
INVITATION_EMAILS_ENABLED=true
INVITATION_CALLBACK_URL=/admin
INVITATION_SEND_LIMIT=50
INVITATION_REMINDER_DAYS=7
INVITATION_SEND_DELAY_MS=1000
INVITATION_SEND_MAX_RETRIES=3
INVITATION_SEND_RETRY_DELAY_MS=5000

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_REPLACE_ME
STRIPE_PLATFORM_FEE_PERCENT=0
STRIPE_DEFAULT_COUNTRY=FR
TICKETING_MAX_PENDING_DRAFTS=5
TICKETING_MAX_DRAFTS_PER_HOUR=10

# --- GitHub trigger ---------------------------------------------------------
GITHUB_TOKEN=ghp_REPLACE_ME
GITHUB_OWNER=play14team
GITHUB_REPO=play14
GITHUB_WORKFLOW_ID=218106378
GITHUB_BRANCH=main

# --- Frontend integration --------------------------------------------------
FRONTEND_URL=https://staging.play14.org
REVALIDATE_SECRET=REPLACE_ME
LOGO_URL=https://staging.play14.org/logo/play14_600x200_transparent-dark.png

# --- Observability ----------------------------------------------------------
# The strapi-prometheus plugin exposes metrics on a separate internal server
# (METRICS_PORT, defaults to 9000) which Clever Cloud's Warp10 scrapes via
# localhost. The separate server has no auth — port 9000 is not routed to
# the public edge, so it's only reachable from inside the instance.
STRAPI_LOG_LEVEL=info
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_SEPARATE_SERVER=true
METRICS_PORT=9000
METRICS_HOST=0.0.0.0
METRICS_PATH=/metrics
CC_METRICS_PROMETHEUS_PORT=9000
CC_METRICS_PROMETHEUS_PATH=/metrics

# --- Security / CORS --------------------------------------------------------
ALLOWED_ORIGINS=https://staging.play14.org,https://api-staging.play14.org,http://localhost:3000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# --- AI Translator (strapi-ai-translator plugin) ---------------------------
# These env var names are what the plugin reads — NOT the same as GEMINI_*.
LLM_TRANSLATOR_LLM_API_KEY=REPLACE_ME
STRAPI_ADMIN_LLM_TRANSLATOR_LLM_MODEL=gemini-2.5-flash
STRAPI_ADMIN_LLM_TRANSLATOR_LLM_PROVIDER=gemini

# --- Misc -------------------------------------------------------------------
CRON_ENABLED=false
EVENT_RESULTS_REMINDERS_ENABLED=true
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash
STRAPI_ADMIN_MAPBOX_ACCESS_TOKEN=pk.REPLACE_ME
