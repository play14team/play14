# Next.js Web — PRODUCTION environment on Clever Cloud
#
# Copy to env-production-web.env, fill in secrets, then:
#   ./set-env.sh play14-web env-production-web.env

# --- Clever Cloud runtime ---------------------------------------------------
CC_NODE_VERSION=22
CC_NODE_BUILD_TOOL=bun
CC_RUN_COMMAND=node packages/web/server.js

# --- Backend ----------------------------------------------------------------
NODE_ENV=production
STRAPI_API_URL=https://community.play14.org
STRAPI_API_SECRET=REPLACE_ME
# STRAPI_FALLBACK_API_URL=
# STRAPI_FALLBACK_API_SECRET=

# --- Public URLs ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://play14.org
NEXT_PUBLIC_STRAPI_URL=https://community.play14.org
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.REPLACE_ME
NEXT_PUBLIC_WEB_VITALS=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME

# --- Auth -------------------------------------------------------------------
TURNSTILE_SECRET_KEY=REPLACE_ME

# --- Frontend revalidation -------------------------------------------------
REVALIDATE_SECRET=REPLACE_ME

# --- Feature flags ----------------------------------------------------------
FEATURE_LOGIN_ENABLED=true
NEXT_PUBLIC_FEATURE_LOGIN_ENABLED=true

# --- Observability ----------------------------------------------------------
SENTRY_DSN=REPLACE_ME
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=REPLACE_ME
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ORG=REPLACE_ME
SENTRY_PROJECT=play14-web

# --- Misc -------------------------------------------------------------------
DEFAULT_BLURHASH=L4SY{q-;~q-;t7t7M{Rj~q-;~q-;
METRICS_TOKEN=REPLACE_ME
