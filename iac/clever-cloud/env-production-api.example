# Strapi API — PRODUCTION environment on Clever Cloud
#
# Copy to env-production-api.env, fill in secrets, then:
#   ./set-env.sh play14-api env-production-api.env
#
# IMPORTANT: APP_KEYS / *_SECRET / *_SALT values must be regenerated fresh
# for production — DO NOT reuse the staging values or the legacy Azure values.

# --- Clever Cloud runtime ---------------------------------------------------
CC_NODE_VERSION=22
CC_NODE_BUILD_TOOL=bun
CC_RUN_COMMAND=bun run start:api
# NOTE: Build instance flavor is NOT an env var — set with:
#   clever scale --build-flavor M --alias play14-api
CC_POST_BUILD_HOOK=bun run build:api

# --- Strapi core ------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PUBLIC_URL=https://community.play14.org

APP_KEYS=REPLACE_KEY1,REPLACE_KEY2,REPLACE_KEY3,REPLACE_KEY4
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME

# --- Database --------------------------------------------------------------
# DO NOT set DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD here — Clever Cloud
# does not perform shell-style $VAR expansion on env values. Strapi config
# falls back to the auto-injected POSTGRESQL_ADDON_* vars from the linked
# add-on, so leave these unset.
DATABASE_CLIENT=postgres
DATABASE_SCHEMA=public
DATABASE_SSL=true
DATABASE_SSL_SELF=false
DATABASE_DEBUG=false

# --- Object storage (Cellar) ------------------------------------------------
UPLOAD_PROVIDER=s3
CELLAR_BUCKET=play14-uploads-prod
CELLAR_REGION=us-east-1
STORAGE_CDN_URL=https://cdn.play14.org

# --- Redis ------------------------------------------------------------------
# Clever Cloud's Redis add-on injects REDIS_URL directly. Do NOT set it
# here — $VAR references would be stored as literal strings.
CACHE_PROVIDER=redis
CACHE_ENABLED=true

# --- Email ------------------------------------------------------------------
SENDER_API_KEY=REPLACE_ME
SENDER_GROUP_ID=REPLACE_ME
EMAIL_DEFAULT_FROM=noreply@play14.org
EMAIL_DEFAULT_FROM_NAME=#play14 community
EMAIL_REPLY_TO=community@play14.org
EMAIL_ADMIN_RECIPIENTS=admin@play14.org

# --- Invitations ------------------------------------------------------------
INVITATION_EMAILS_ENABLED=true
INVITATION_CALLBACK_URL=/admin
INVITATION_SEND_LIMIT=200
INVITATION_REMINDER_DAYS=7
INVITATION_SEND_DELAY_MS=2000
INVITATION_SEND_MAX_RETRIES=3
INVITATION_SEND_RETRY_DELAY_MS=10000

# --- Stripe (LIVE keys) ----------------------------------------------------
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_REPLACE_ME
STRIPE_PLATFORM_FEE_PERCENT=0
STRIPE_DEFAULT_COUNTRY=FR
TICKETING_MAX_PENDING_DRAFTS=5
TICKETING_MAX_DRAFTS_PER_HOUR=10

# --- GitHub trigger ---------------------------------------------------------
GITHUB_TOKEN=ghp_REPLACE_ME
GITHUB_OWNER=play14team
GITHUB_REPO=play14-web
GITHUB_WORKFLOW_ID=217740349
GITHUB_BRANCH=main

# --- Frontend integration --------------------------------------------------
FRONTEND_URL=https://play14.org
REVALIDATE_SECRET=REPLACE_ME

# --- Observability ----------------------------------------------------------
SENTRY_DSN=REPLACE_ME
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_SEPARATE_SERVER=true
METRICS_PORT=9000
METRICS_HOST=0.0.0.0
METRICS_PATH=/metrics

# --- Security / CORS --------------------------------------------------------
ALLOWED_ORIGINS=https://play14.org,https://www.play14.org,https://community.play14.org
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# --- Misc -------------------------------------------------------------------
CRON_ENABLED=true
EVENT_RESULTS_REMINDERS_ENABLED=true
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.0-flash
STRAPI_ADMIN_MAPBOX_ACCESS_TOKEN=pk.REPLACE_ME
