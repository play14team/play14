# Next.js Web — STAGING environment on Clever Cloud
#
# Copy to env-staging-web.env, fill in secrets, then:
#   ./set-env.sh play14-web-staging env-staging-web.env

# --- Clever Cloud runtime ---------------------------------------------------
CC_NODE_VERSION=22
CC_NODE_BUILD_TOOL=bun
# This is a Bun workspace monorepo deployed from the repo root.
# Clever Cloud's Bun runtime swallows --cwd flags when parsing
# CC_RUN_COMMAND, so use a root-level alias script. start:web in the
# root package.json delegates to packages/web.
CC_RUN_COMMAND=bun run start:web
# NOTE: Next.js build is memory-heavy. Build flavor is set via
# `clever scale --build-flavor M --alias <app>`, not as an env var.
# Build the web package (next build) after install.
CC_POST_BUILD_HOOK=bun run build:web

# --- Backend ----------------------------------------------------------------
NODE_ENV=production
STRAPI_API_URL=https://api-staging.play14.org
STRAPI_API_SECRET=REPLACE_ME

# --- Public URLs (NEXT_PUBLIC_* are baked at build time) -------------------
NEXT_PUBLIC_SITE_URL=https://staging.play14.org
NEXT_PUBLIC_STRAPI_URL=https://api-staging.play14.org
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.REPLACE_ME
NEXT_PUBLIC_WEB_VITALS=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME

# --- Auth -------------------------------------------------------------------
TURNSTILE_SECRET_KEY=REPLACE_ME

# --- Frontend revalidation (must match API value) -------------------------
REVALIDATE_SECRET=REPLACE_ME

# --- Feature flags ----------------------------------------------------------
FEATURE_LOGIN_ENABLED=true
NEXT_PUBLIC_FEATURE_LOGIN_ENABLED=true

# --- Observability ----------------------------------------------------------
# Clever Cloud's Warp10 scrapes the /api/metrics endpoint over localhost, on
# the port exposed to the edge (PORT env var, defaults to 8080 on the Node.js
# runtime — NOT 3000). Setting the wrong port results in empty Grafana
# dashboards because the scrape silently fails with connection refused.
#
# Authentication is HTTP Basic Auth. Set both USER and PASSWORD below to
# lock the endpoint down. Leaving them unset is also safe — the endpoint is
# only reachable from inside Clever Cloud's private network.
LOG_LEVEL=info
CC_METRICS_PROMETHEUS_PORT=8080
CC_METRICS_PROMETHEUS_PATH=/api/metrics
CC_METRICS_PROMETHEUS_USER=metrics
CC_METRICS_PROMETHEUS_PASSWORD=REPLACE_ME

# --- Misc -------------------------------------------------------------------
DEFAULT_BLURHASH=L4SY{q-;~q-;t7t7M{Rj~q-;~q-;
