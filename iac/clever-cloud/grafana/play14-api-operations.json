      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(play14_stripe_api_duration_seconds_bucket{app_id=~\"$APP_ID\"}[$__rate_interval]))",
