# Strapi API Configuration
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token_here

# Apify Configuration (LinkedIn scraping)
APIFY_API_TOKEN=your_apify_api_token_here
# Optional: Override the default LinkedIn scraper actor
# Default: vulnv/linkedin-profile-scraper (pay-per-use, ~$0.05 start + $0.00425/profile)
# APIFY_LINKEDIN_ACTOR=vulnv/linkedin-profile-scraper
# Optional: Minimum delay between Apify scrape requests (ms, default: 5000)
# APIFY_MIN_DELAY_MS=5000

# Optional: Timeout and rate limiting configuration
# Fetch timeout in milliseconds (default: 30000)
# FETCH_TIMEOUT_MS=30000
# Delay between consecutive Strapi requests in ms (default: 100)
# STRAPI_REQUEST_DELAY_MS=100

# Optional: Field length limits
# Maximum bio length in characters (default: 10000)
# MAX_BIO_LENGTH=10000
# Maximum company name length in characters (default: 200)
# MAX_COMPANY_LENGTH=200
# Maximum tagline length in characters (default: 500)
# MAX_TAGLINE_LENGTH=500

# Optional: Safety limits
# Maximum total players to fetch (default: 10000)
# MAX_PLAYERS_FETCH=10000
