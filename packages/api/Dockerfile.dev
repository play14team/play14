# Multi-stage development Dockerfile with dependency caching
# Build context: monorepo root (use -f packages/api/Dockerfile.dev .)

# Stage 1: Dependencies - only rebuilds when package files change
FROM oven/bun:1.3.5-alpine AS dependencies
RUN apk update && apk add --no-cache build-base gcc autoconf automake zlib-dev libpng-dev vips-dev git > /dev/null 2>&1

WORKDIR /app

# Copy workspace root files for bun workspace resolution
COPY package.json bun.lock ./

# Copy the api package.json for dependency resolution
COPY packages/api/package.json ./packages/api/

# Install all dependencies (including dev)
RUN bun install --frozen-lockfile

# Stage 2: Development runtime
FROM oven/bun:1.3.5-alpine AS development
RUN apk update && apk add --no-cache vips-dev

ARG NODE_ENV=development
ENV NODE_ENV=${NODE_ENV}

WORKDIR /app

# Copy dependencies from the dependencies stage (cached layer)
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/package.json ./package.json

# Copy source code (invalidates cache on code changes, but dependencies layer is preserved)
COPY packages/api ./packages/api

WORKDIR /app/packages/api

ENV PATH=/app/node_modules/.bin:$PATH

RUN chown -R bun:bun /app
USER bun

EXPOSE 1337

CMD ["strapi", "develop"]
