# Multi-stage development Dockerfile with dependency caching
# Stage 1: Dependencies - only rebuilds when package.json or bun.lock changes
FROM oven/bun:1.3.5-alpine as dependencies
RUN apk update && apk add --no-cache build-base gcc autoconf automake zlib-dev libpng-dev vips-dev git nodejs > /dev/null 2>&1

WORKDIR /opt/
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Stage 2: Development runtime - rebuilds when source code changes
FROM oven/bun:1.3.5-alpine as development
RUN apk update && apk add --no-cache vips-dev nodejs

ARG NODE_ENV=development
ENV NODE_ENV=${NODE_ENV}

WORKDIR /opt/
# Copy dependencies from the dependencies stage (cached layer)
COPY --from=dependencies /opt/node_modules ./node_modules
ENV PATH /opt/node_modules/.bin:$PATH

WORKDIR /opt/app
# Copy source code (invalidates cache on code changes, but dependencies layer is preserved)
COPY . .

RUN chown -R bun:bun /opt/app
USER bun
EXPOSE 1337
# Use strapi CLI directly which works better with Bun
CMD ["strapi", "develop"]
