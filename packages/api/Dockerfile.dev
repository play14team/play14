# Multi-stage development Dockerfile with dependency caching
# Build context: monorepo root (use -f packages/api/Dockerfile.dev .)

# Stage 1: Dependencies - use bun for fast dependency installation
FROM oven/bun:1.3.5-alpine AS dependencies
RUN apk update && apk add --no-cache build-base gcc autoconf automake zlib-dev libpng-dev vips-dev git > /dev/null 2>&1

WORKDIR /app

# Copy root package files
COPY package.json bun.lock ./

# Copy ALL workspace package.json files (bun workspaces require all to exist)
COPY packages/api/package.json ./packages/api/
COPY packages/web/package.json ./packages/web/
COPY packages/design/package.json ./packages/design/

# Install all dependencies (including dev)
RUN bun install --frozen-lockfile

# Stage 2: Development runtime - use node for Strapi (Koa.js compatibility)
FROM node:22-alpine AS development
RUN apk update && apk add --no-cache vips-dev

ARG NODE_ENV=development
ENV NODE_ENV=${NODE_ENV}

WORKDIR /app

# Copy dependencies from the dependencies stage (cached layer)
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/package.json ./package.json

# Copy source code
COPY packages/api ./packages/api

WORKDIR /app/packages/api

RUN chown -R node:node /app
USER node

EXPOSE 1337

CMD ["npx", "strapi", "develop"]
