{
  "name": "play14-api",
  "version": "2.0.0",
  "private": true,
  "description": "#play14 api",
  "license": "MIT",
  "author": {
    "name": "Cédric Pontet"
  },
  "scripts": {
    "build": "bun run build:plugins && strapi build",
    "build:plugins": "bun build ./src/plugins/strapi-extended-mcp/server/index.ts --target node --format cjs --packages external --outfile ./src/plugins/strapi-extended-mcp/dist/server/index.js && bun build ./src/plugins/rebuild-trigger/server/index.ts --target node --format cjs --packages external --outfile ./src/plugins/rebuild-trigger/dist/server/index.js",
    "dev": "bun run build:plugins && TZ=UTC strapi develop",
    "export": "strapi export --file ../backup/database/play14",
    "import": "strapi import --file ../backup/database/play14.tar.gz.enc",
    "start": "strapi start",
    "strapi": "strapi",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write src",
    "check": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "podman-compose -f ../../compose.yaml up -d play14-db-test",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "posttest:integration": "podman-compose -f ../../compose.yaml stop play14-db-test",
    "test:integration:ci": "vitest run -c vitest.integration.config.mts",
    "pretest:integration:watch": "podman-compose -f ../../compose.yaml up -d play14-db-test",
    "test:integration:watch": "vitest -c vitest.integration.config.mts",
    "posttest:integration:watch": "podman-compose -f ../../compose.yaml stop play14-db-test",
    "test:all": "bun run test && bun run test:integration",
    "test:emails": "bun run scripts/test-emails-simple.ts",
    "ts:generate-types": "strapi ts:generate-types",
    "ts:generate-types:watch": "strapi ts:generate-types --watch",
    "dev:db": "podman-compose up -d play14-db && bun run build:plugins && TZ=UTC strapi develop",
    "dev:pods": "podman-compose up --build",
    "db": "podman-compose up -d play14-db",
    "up": "podman-compose up && podman logs -f play14-api",
    "down": "podman-compose down"
  },
  "dependencies": {
    "@_sh/strapi-plugin-ckeditor": "^7.1.0",
    "@google/generative-ai": "^0.24.1",
    "@mapbox/mapbox-sdk": "^0.16.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "@strapi/design-system": "^2.2.1",
    "@strapi/icons": "^2.2.1",
    "@strapi/plugin-documentation": "^5.49.0",
    "@strapi/plugin-users-permissions": "5.49.0",
    "@strapi/strapi": "5.49.0",
    "@strapi/utils": "5.49.0",
    "@types/pdfkit": "^0.17.6",
    "ics": "^3.12.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.18.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "react-router-dom": "~6.30.3",
    "slugify": "^1.6.9",
    "strapi-ai-translator": "^0.14.0",
    "strapi-cache": "^1.11.1",
    "strapi-plugin-config-sync": "^3.2.0",
    "strapi-plugin-country-select": "^2.1.0",
    "strapi-plugin-fuzzy-search": "4.1.0",
    "strapi-plugin-map-field": "^2.0.0",
    "strapi-plugin-multi-select": "2.1.1",
    "strapi-plugin-timezone-select": "^2.0.0",
    "strapi-plugin-webp-converter": "^1.0.4",
    "strapi-prometheus": "^2.6.0",
    "strapi-provider-email-sender": "file:providers/strapi-provider-email-sender",
    "@strapi/provider-upload-aws-s3": "^5.49.0",
    "@strapi/typescript-utils": "^5.49.0",
    "stripe": "^22.3.0",
    "styled-components": "~6.3.11",
    "zod": "^4.4.3"
  },
  "strapi": {
    "uuid": "57f1478c-cf26-4149-8239-82091268fbc1"
  },
  "packageManager": "bun@1.3.5",
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
