{
  "kind": "collectionType",
  "collectionName": "ticket_orders",
  "info": {
    "singularName": "ticket-order",
    "pluralName": "ticket-orders",
    "displayName": "Ticket Order",
    "description": "Ticket purchase orders"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "orderNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "orderStatus": {
      "type": "enumeration",
      "enum": [
        "draft",
        "pending",
        "processing",
        "paid",
        "cancelled",
        "refunded",
        "partially_refunded",
        "expired",
        "failed"
      ],
      "default": "draft",
      "required": true
    },
    "totalAmount": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "currency": {
      "type": "string",
      "required": true,
      "default": "EUR"
    },
    "paymentProvider": {
      "type": "enumeration",
      "enum": ["stripe", "manual"],
      "required": true
    },
    "providerOrderId": {
      "type": "string"
    },
    "providerSessionId": {
      "type": "string",
      "index": true
    },
    "purchaserEmail": {
      "type": "email",
      "required": true
    },
    "purchaserName": {
      "type": "string",
      "required": true
    },
    "paidAt": {
      "type": "datetime"
    },
    "refundedAt": {
      "type": "datetime"
    },
    "refundAmount": {
      "type": "decimal",
      "min": 0
    },
    "refundReason": {
      "type": "text"
    },
    "notes": {
      "type": "text"
    },
    "ticketDetails": {
      "type": "json"
    },
    "player": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::player.player"
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event"
    },
    "tickets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ticket.ticket",
      "mappedBy": "order"
    },
    "discountCode": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::discount-code.discount-code"
    },
    "discountAmount": {
      "type": "decimal",
      "min": 0,
      "default": 0
    },
    "originalAmount": {
      "type": "decimal",
      "min": 0
    },
    "attendeeDetails": {
      "type": "json",
      "description": "Attendee info collected before payment, keyed by ticket index"
    },
    "gdprConsent": {
      "type": "boolean",
      "default": false
    },
    "gdprConsentTimestamp": {
      "type": "datetime"
    },
    "termsAccepted": {
      "type": "boolean",
      "default": false
    },
    "termsAcceptedTimestamp": {
      "type": "datetime"
    },
    "hasReservation": {
      "type": "boolean",
      "default": false
    },
    "reservationCreatedAt": {
      "type": "datetime"
    },
    "reservationExpiresAt": {
      "type": "datetime"
    }
  }
}
