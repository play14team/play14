# Runtime-only Dockerfile for CI pre-built Strapi application
# Build context: project root (needs node_modules and packages/api)
#
# This Dockerfile is used by GitHub Actions workflows for faster builds.
# The multi-stage Dockerfile is still available for local development.

FROM oven/bun:1.3.5-alpine AS runner

# Install runtime dependencies (vips for image processing)
RUN apk add --no-cache vips-dev nodejs

ENV NODE_ENV=production
ENV TZ=UTC

WORKDIR /app

# Copy node_modules from CI (pre-installed)
COPY --chown=bun:bun node_modules ./node_modules

# Copy built API package
COPY --chown=bun:bun packages/api ./packages/api

# Add node_modules/.bin to PATH for strapi CLI
ENV PATH=/app/node_modules/.bin:$PATH

WORKDIR /app/packages/api

USER bun

EXPOSE 1337

CMD ["strapi", "start"]
