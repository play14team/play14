{
  "extends": "@strapi/typescript-utils/tsconfigs/server",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": false,
    "module": "ES2022",
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": [
    "./",
    "src/**/*.json",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules/",
    "build/",
    "dist/",
    ".cache/",
    ".tmp/",
    "src/admin/",
    "**/*.test.ts",
    "**/*.test.js",
    "src/plugins/*/admin/**",
    "bootstrap/",
    "types/generated/**",
    "database/migrations/**"
  ]
}
