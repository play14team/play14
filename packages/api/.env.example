# Environment
NODE_ENV = "development | test | production"

CRON_ENABLED=true

# Server
HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
PUBLIC_URL=<url>

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=supersecurepwd
DATABASE_SSL=true
DATABASE_DEBUG=false

# Admin
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
STRAPI_LOG_LEVEL=trace
JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified

# Azure Web App
STORAGE_ACCOUNT=
STORAGE_ACCOUNT_KEY=
STORAGE_CONTAINER_NAME=
STORAGE_URL=
STORAGE_CDN_URL=

# GitHub Integration
GITHUB_TOKEN=
GITHUB_OWNER=play14team
GITHUB_REPO=play14-web
GITHUB_WORKFLOW_ID=52506304
GITHUB_BRANCH=main

# Mapbox
STRAPI_ADMIN_MAPBOX_ACCESS_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxx

# Cache Configuration
CACHE_ENABLED=true
CACHE_DEBUG=false
CACHE_PROVIDER=memory
CACHE_MAX_ITEMS=1000
CACHE_MAX_SIZE=1073741824
CACHE_TTL=3600000
# Redis URL (only needed if CACHE_PROVIDER=redis)
# REDIS_URL=redis://localhost:6379

# OAuth Providers (configured in Strapi Admin UI: Settings → Users & Permissions → Providers)
# These are for reference only - actual configuration is done in Strapi Admin
# GITHUB_OAUTH_CLIENT_ID=your-github-client-id
# GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
# LINKEDIN_OAUTH_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_OAUTH_CLIENT_SECRET=your-linkedin-client-secret
# Frontend callback URLs:
# - GitHub: ${FRONTEND_URL}/connect/github/redirect
# - Google: ${FRONTEND_URL}/connect/google/redirect
# - LinkedIn: ${FRONTEND_URL}/connect/linkedin/redirect

# Email (Resend)
RESEND_API_KEY=<your-resend-api-key>
RESEND_DEFAULT_FROM=noreply@play14.org
RESEND_REPLY_TO=community@play14.org
EMAIL_ADMIN_RECIPIENTS=admin1@play14.org,admin2@play14.org
FRONTEND_URL=https://play14.org
LOGO_URL=https://play14.org/logo/play14_600x200_transparent-dark.png

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Stripe Connect (for destination charges to hosts)
STRIPE_PLATFORM_FEE_PERCENT=0

# Rate Limiting
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Sentry (Error Tracking & APM)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=development
SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_TOKEN=your-secure-metrics-token