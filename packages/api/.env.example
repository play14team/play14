# Environment
NODE_ENV = "development | test | production"

CRON_ENABLED=true

# Server
HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
PUBLIC_URL=https://community.play14.org
FRONTEND_URL=https://play14.org
LOGO_URL=https://play14.org/logo/play14_600x200_transparent-dark.png

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=play14_dev
DATABASE_USERNAME=usr_play14_dev
DATABASE_PASSWORD=supersecurepwd
DATABASE_SSL=true
DATABASE_DEBUG=false

# Integration test database (play14-db-test in compose.yaml)
# Read by config/env/test/database.ts, which deliberately ignores the
# DATABASE_* keys above: Strapi loads this file in every environment, so
# sharing the prefix would let the development credentials point a test run at
# the development database. Leave these unset to take the defaults below.
# Keep TEST_DATABASE_PORT equal to PLAY14_DB_TEST_PORT in the root .env.
# TEST_DATABASE_HOST=localhost
# TEST_DATABASE_PORT=5433
# TEST_DATABASE_NAME=play14_test
# TEST_DATABASE_USERNAME=test_user
# TEST_DATABASE_PASSWORD=test_password

# Admin
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
STRAPI_LOG_LEVEL=trace
JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified

# Object Storage (Cellar in staging/prod, MinIO locally)
# The upload plugin uses @strapi/provider-upload-aws-s3 and talks to any
# S3-compatible backend. Clever Cloud's Cellar add-on auto-injects
# CELLAR_ADDON_HOST / KEY_ID / KEY_SECRET in staging and production — leave
# those unset there. Locally, the values below target the `minio` service
# defined in compose.yaml.
# compose network hostname. When running the API on the host
# (`bun --filter play14-api dev`) instead of in a container, use
# CELLAR_ADDON_HOST=localhost:9100.
CELLAR_ADDON_HOST=play14-minio:9000
CELLAR_ADDON_KEY_ID=minioadmin
CELLAR_ADDON_KEY_SECRET=minioadmin
CELLAR_BUCKET=play14-uploads
CELLAR_REGION=us-east-1
# Local MinIO is plain HTTP and uses path-style URLs (http://host/bucket/key).
# Cellar in staging/prod wants TLS on + virtual-hosted-style — leave both
# vars unset there so the defaults apply (TLS=true, path-style=false).
CELLAR_ADDON_TLS=false
CELLAR_FORCE_PATH_STYLE=true
# Public base URL Strapi returns for uploaded files. Locally this is the
# MinIO S3 endpoint exposed on the host. In staging/prod this is the
# Cloudflare-fronted Cellar CDN (e.g. https://cdn.play14.org).
STORAGE_CDN_URL=http://localhost:9100/play14-uploads

# MinIO root credentials (read by compose.yaml, not by Strapi)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# GitHub Integration
GITHUB_TOKEN=
GITHUB_OWNER=play14team
GITHUB_REPO=play14-web
GITHUB_WORKFLOW_ID=52506304
GITHUB_BRANCH=main

# Mapbox
STRAPI_ADMIN_MAPBOX_ACCESS_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxx

# Cache Configuration
CACHE_ENABLED=true
CACHE_DEBUG=true
# Cache authorized requests (use only for routes that return identical data for all users)
CACHE_AUTHORIZED_REQUESTS=false
# Cache provider: "memory" (default) or "redis"
# - memory: In-memory cache, faster but not shared across containers
# - redis: Redis-based cache, shared across containers (requires REDIS_URL)
CACHE_PROVIDER=redis
# Memory cache settings (used when CACHE_PROVIDER=memory)
CACHE_MAX_ITEMS=1000
CACHE_MAX_SIZE=1073741824
CACHE_TTL=3600000

# Redis Configuration
# Used for:
# 1. API response caching when CACHE_PROVIDER=redis
# 2. Distributed cron locking (prevents duplicate runs in multi-container deployments)
# If not set, cron jobs run without locking (suitable for single-instance deployments)
REDIS_URL=redis://localhost:6379

# Email (Sender.net)
SENDER_API_KEY=<your-sender-api-key>
SENDER_GROUP_ID=<your-sender-newsletter-group-id>
EMAIL_DEFAULT_FROM=noreply-dev@play14.org
EMAIL_REPLY_TO=admin@play14.org
EMAIL_ADMIN_RECIPIENTS=admin@play14.org

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_xxx
STRIPE_PLATFORM_FEE_PERCENT=0

# CORS Configuration
# SECURITY: ALLOWED_ORIGINS must be explicitly configured - wildcard (*) is NOT allowed in production.
# This prevents any website from making authenticated requests to your API.
# Comma-separated list of allowed origins:
# - Development: ALLOWED_ORIGINS=http://localhost:3000
# - Production: ALLOWED_ORIGINS=https://play14.org,https://www.play14.org
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_SEPARATE_SERVER=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9000
METRICS_PATH=/metrics

# Invitation Emails
INVITATION_EMAILS_ENABLED=false
INVITATION_SEND_DELAY_MS=2000
INVITATION_SEND_MAX_RETRIES=3
INVITATION_SEND_RETRY_DELAY_MS=5000

# Event Results Reminder Emails
# Sends reminders to event contacts 15 days after event ends (up to 3 reminders)
EVENT_RESULTS_REMINDERS_ENABLED=false

# On-demand Revalidation Secret
# Used to trigger cache invalidation in the frontend after ticket purchases/refunds
# Must match REVALIDATE_SECRET in packages/web/.env
REVALIDATE_SECRET=your-shared-revalidation-secret-here

# Google Gemini AI
# Used for generating LinkedIn post content and Strapi content translation
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# LLM Translator Plugin (strapi-ai-translator)
# Enables one-click translation of Strapi content using Google Gemini
LLM_TRANSLATOR_LLM_API_KEY=your-gemini-api-key-here
STRAPI_ADMIN_LLM_TRANSLATOR_LLM_MODEL=gemini-2.5-flash
STRAPI_ADMIN_LLM_TRANSLATOR_LLM_PROVIDER=gemini

# Admin token for the Strapi MCP server generated from the admin panel.
# Used to authenticate requests from the MCP server to the Strapi API.
STRAPI_MCP_TOKEN=your-mcp-token-here
