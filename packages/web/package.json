    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@sentry/nextjs": "^10.35.0",
    "@strapi/client": "^1.6.0",
    "@tiptap/extension-blockquote": "^3.16.0",
    "@tiptap/extension-heading": "^3.16.0",
    "@tiptap/extension-horizontal-rule": "^3.16.0",
    "@tiptap/extension-link": "^3.16.0",
    "@tiptap/pm": "^3.16.0",
    "@tiptap/react": "^3.16.0",
    "@tiptap/starter-kit": "^3.16.0",
    "clsx": "^2.1.1",
    "country-locale-map": "^1.9.12",
    "date-fns": "^4.0.0",
    "fuse.js": "^7.1.0",
    "html-react-parser": "^5.2.11",
    "i18n-iso-countries": "^7.14.0",
    "ics": "^3.8.1",
    "isomorphic-dompurify": "^2.35.0",
    "lodash": "^4.17.21",
    "mapbox-gl": "^3.18.0",
    "next": "^16.1.4",
    "next-safe-action": "^8.0.11",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "prom-client": "^15.1.3",
    "qs": "^6.14.1",
    "react": "^19.2.3",
    "react-audio-player": "^0.17.0",
    "react-big-calendar": "^1.19.4",
    "react-collapsed": "^4.2.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.3",
    "react-map-gl": "^8.1.0",
    "react-photo-album": "^3.4.0",
    "react-spinners": "^0.17.0",
    "recharts": "^3.6.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tiptap-markdown": "^0.9.0",
    "yet-another-react-lightbox": "^3.28.0",
    "zod": "^4.3.5"
