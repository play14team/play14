    "@types/mapbox__mapbox-gl-geocoder": "^5.1.0",
    "@types/mapbox__mapbox-sdk": "^0.16.3",
    "@types/node": "^25.0.9",
    "@types/qs": "^6.14.0",
    "@types/react": "19.2.9",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "19.2.3",
    "@types/react-html-parser": "^2.0.7",
    "@types/react-map-gl": "^6.1.7",
    "@vitest/coverage-v8": "^4.0.16",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "purify-css": "^1.2.5",
    "sass": "^1.97.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss}": "biome check --write --no-errors-on-unmatched"
  },
  "packageManager": "bun@1.3.5"
