{
  "name": "play14-web",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "develop": "METRICS_PORT=9001 next dev --turbopack",
    "build": "next build && cp -R public .next/standalone/packages/web/ && cp -R .next/static .next/standalone/packages/web/.next/",
    "start": "HOSTNAME=0.0.0.0 bun .next/standalone/packages/web/server.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "format": "biome format --write src",
    "check": "biome check .",
    "dev": "bun develop",
    "dev:pods": "podman-compose up --build",
    "up": "podman-compose up -d && podman logs -f play14-web",
    "down": "podman-compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "bunx playwright install --with-deps chromium"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@mapbox/mapbox-gl-geocoder": "^5.1.3",
    "@mapbox/mapbox-sdk": "^0.16.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@strapi/client": "^1.6.2",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/country-data": "^0.0.5",
    "@types/lodash": "^4.17.27",
    "@types/mapbox-gl": "^3.5.0",
    "@types/mapbox__mapbox-gl-geocoder": "^5.1.2",
    "@types/mapbox__mapbox-sdk": "^0.16.5",
    "@types/node": "^26.6.5",
    "@types/qs": "^6.15.1",
    "@types/react": "19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "19.3.0",
    "@types/react-html-parser": "^2.0.7",
    "@types/react-map-gl": "^6.1.10",
    "@types/sanitize-html": "^2.16.2",
    "clsx": "^2.1.1",
    "country-locale-map": "^1.9.14",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "html-react-parser": "^6.1.9",
    "i18n-iso-countries": "^7.14.0",
    "ics": "^3.12.1",
    "lodash": "^4.18.1",
    "mapbox-gl": "^3.33.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "prom-client": "^15.1.3",
    "qs": "^6.16.1",
    "react": "^19.3.1",
    "react-audio-player": "^0.17.0",
    "react-big-calendar": "^1.20.0",
    "react-collapsed": "^4.2.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "react-photo-album": "^3.6.2",
    "react-spinners": "^0.17.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^6.0.2",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "purify-css": "^1.2.5",
    "sass": "^1.106.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss}": "biome check --write --no-errors-on-unmatched"
  },
  "packageManager": "bun@1.3.5"
}
