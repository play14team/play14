{
  "name": "play14-web",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "develop": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "check": "biome check .",
    "dev": "bun develop",
    "dev:pods": "podman-compose up --build",
    "up": "podman-compose up -d && podman logs -f play14-web",
    "down": "podman-compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "bunx playwright install --with-deps chromium"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "@mapbox/mapbox-sdk": "^0.16.2",
