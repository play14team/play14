    "@types/country-data": "^0.0.5",
    "@types/lodash": "^4.17.21",
    "@types/mapbox-gl": "^3.4.1",
    "@types/mapbox__mapbox-gl-geocoder": "^5.1.0",
    "@types/mapbox__mapbox-sdk": "^0.16.3",
    "@types/moment-timezone": "^0.5.30",
