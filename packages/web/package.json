    "i18n-iso-countries": "^7.14.0",
    "ics": "^3.8.1",
    "keyv": "^5.5.5",
    "lodash": "^4.17.21",
    "mapbox-gl": "^3.17.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "next": "^16.1.1",
    "next-safe-action": "^8.0.11",
    "next-themes": "^0.4.6",
    "qs": "^6.14.1",
    "react": "^19.2.3",
