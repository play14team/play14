# Multi-stage development Dockerfile with dependency caching
# Build context: monorepo root (use -f packages/web/Dockerfile.dev .)

# Stage 1: Dependencies
FROM oven/bun:1.3.5-alpine AS deps

WORKDIR /app

# Copy root package files
COPY package.json bun.lock ./

# Copy ALL workspace package.json files (bun workspaces require all to exist)
COPY packages/api/package.json ./packages/api/
COPY packages/web/package.json ./packages/web/
COPY packages/design/package.json ./packages/design/

# Install dependencies with frozen lockfile
RUN bun install --frozen-lockfile

# Stage 2: Development
FROM oven/bun:1.3.5-alpine AS development

WORKDIR /app

# Copy installed dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json

# Copy web package source
# Note: Source files can be mounted as volumes for hot reload
COPY packages/web ./packages/web

WORKDIR /app/packages/web

# Expose port 3000
EXPOSE 3000

# Start development server with Turbopack
CMD ["bun", "run", "develop"]
