# ===================================
# DEVELOPMENT ENVIRONMENT
# ===================================

# Backend API
# For local development with containerized Strapi
STRAPI_API_URL=http://localhost:1337
STRAPI_API_SECRET=your-strapi-api-secret-here

# For local development connecting to production
# STRAPI_API_URL=https://community.play14.org
# STRAPI_API_SECRET=your-production-token

# Map Integration
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# Optional
NEXT_PUBLIC_WEB_VITALS=false

# Frontend URL (used for OAuth callbacks and Stripe redirects)
# Note: Production deployments use NEXT_PUBLIC_SITE_URL, but NEXT_PUBLIC_URL is also supported
NEXT_PUBLIC_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000  # Alternative (used in Azure deployments)

# ===================================
# PRODUCTION ENVIRONMENT (.env.production)
# ===================================
# Copy this section to .env.production for production builds

# Backend API (Production)
# STRAPI_API_URL=https://community.play14.org
# STRAPI_API_SECRET=your-production-strapi-token

# Map Integration (Production)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-production-mapbox-token

# Optional (Production)
# NEXT_PUBLIC_WEB_VITALS=true

# Frontend URL (Production)
# Note: Production deployments use NEXT_PUBLIC_SITE_URL via Azure deployment workflows
# NEXT_PUBLIC_URL=https://play14.org
# NEXT_PUBLIC_SITE_URL=https://play14.org

# ===================================
# OBSERVABILITY
# ===================================

# Sentry (Error Tracking & APM)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ORG=play14
SENTRY_PROJECT=play14-web
SENTRY_AUTH_TOKEN=sntrys_xxx
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus Metrics
METRICS_TOKEN=your-secure-metrics-token

# ===================================
# FEATURE FLAGS
# ===================================

# Enable/disable login functionality
NEXT_PUBLIC_FEATURE_LOGIN_ENABLED=false

# ===================================
# SECURITY
# ===================================

# Cloudflare Turnstile (CAPTCHA)
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

