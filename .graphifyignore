# .graphifyignore — extra exclusions for the knowledge graph (gitignore syntax).
#
# graphify already honours .gitignore, so node_modules/, .next/, coverage/ and
# friends are out. This file drops the tracked files that add cost without
# adding meaning to the graph. Exclusions only — a negation (!) here cannot
# re-include something .gitignore already dropped.

############################
# Binary + design assets
############################

# Vector/raster source art: 35 MB .ai/.eps each, no extractable structure.
packages/design/logo/
packages/design/font/
packages/design/qr-codes/

# Images are routed to LLM vision extraction. Nothing in this repo's PNG/JPG/SVG
# set describes architecture, so indexing them costs tokens and returns noise.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.ico
*.svg
*.psd
*.ai
*.eps

# Web fonts.
*.ttf
*.otf
*.woff
*.woff2

############################
# Generated + vendored
############################

# Strapi regenerates these from the content-type schemas, which are indexed.
packages/api/types/generated/

# Bundled Swagger UI (single 2.4 MB HTML file).
packages/api/src/extensions/documentation/public/

# Storybook static build output.
packages/design/storybook/storybook-static/

# Grafana dashboard JSON — machine-authored, thousands of lines of panel config.
iac/clever-cloud/grafana/

# Lockfile: 1.8 MB of resolved versions.
bun.lock

# Minified/compiled leftovers.
*.min.js
*.min.css
*.map

############################
# Self-reference
############################

# graphify's own skill body would otherwise show up as a top community.
.claude/skills/graphify/

# Graph outputs, in case GRAPHIFY_OUT points somewhere else.
graphify-out/
